  "solution_code": "# concepts: continuous rotation, hue interpolation, uniform temporal sequencing, geometric rigidity\n# description:\n# In the input you will see a glowing square ring with its internal line-mesh at zero orientation,\n# a single highlight point on the ring’s perimeter at medium brightness, and a short rainbow gradient\n# spanning one quadrant of the ring’s border.\n# To make the output, show the ring after one full cycle: return to zero orientation,\n# complete the rainbow gradient around the entire circumference, and place the highlight point at max brightness.\n\nfrom common import *\nimport numpy as np\nimport random\n\ndef main(input_grid):\n    h,w = input_grid.shape\n    cx,cy = (h-1)//2,(w-1)//2\n    R = cx\n    border = []\n    for t in range(R): border.append((cx+R, cy-t))\n    for t in range(2*R): border.append((cx+R-t, cy-R))\n    for t in range(2*R): border.append((cx-R, cy-R+t))\n    for t in range(2*R): border.append((cx-R+t, cy+R))\n    for t in range(R): border.append((cx+R, cy+R-t))\n    rainbow = [Color.RED, Color.ORANGE, Color.YELLOW, Color.GREEN, Color.TEAL, Color.BLUE, Color.MAROON]\n    out = input_grid.copy()\n    for i,(x,y) in enumerate(border):\n        out[x,y] = (Color.RED if i==0 else rainbow[i % len(rainbow)])\n    return out\n\ndef generate_input():\n    R = random.randint(3,7)\n    n = 2*R+1\n    grid = np.zeros((n,n), int)\n    cx=cy=R\n    border = []\n    for t in range(R): border.append((cx+R, cy-t))\n    for t in range(2*R): border.append((cx+R-t, cy-R))\n    for t in range(2*R): border.append((cx-R, cy-R+t))\n    for t in range(2*R): border.append((cx-R+t, cy+R))\n    for t in range(R): border.append((cx+R, cy+R-t))\n    rainbow = [Color.RED, Color.ORANGE, Color.YELLOW, Color.GREEN, Color.TEAL, Color.BLUE, Color.MAROON]\n    grid[border[0]] = Color.PINK\n    qlen = len(border)//4\n    for j in range(1, qlen+1): grid[border[j]] = rainbow[(j-1) % len(rainbow)]\n    draw_line(grid, cx, 0, cx, n-1, color=Color.GREY)\n    draw_line(grid, 0, cy, n-1, cy, color=Color.GREY)\n    return grid",
  "neutral_code": "from common import *\nimport numpy as np\nimport random\n\n# input grid: square grid with grey divider lines and a partially colored perimeter path\n# output: copy of input with the full perimeter path filled by a repeating ordered color sequence\n\ndef main(input_grid):\n    height, width = input_grid.shape\n    center_x, center_y = (height-1)//2, (width-1)//2\n    radius = center_x\n    perimeter_cells = []\n    for offset in range(radius): perimeter_cells.append((center_x+radius, center_y-offset))\n    for offset in range(2*radius): perimeter_cells.append((center_x+radius-offset, center_y-radius))\n    for offset in range(2*radius): perimeter_cells.append((center_x-radius, center_y-radius+offset))\n    for offset in range(2*radius): perimeter_cells.append((center_x-radius+offset, center_y+radius))\n    for offset in range(radius): perimeter_cells.append((center_x+radius, center_y+radius-offset))\n    ordered_colors = [Color.RED, Color.ORANGE, Color.YELLOW, Color.GREEN, Color.TEAL, Color.BLUE, Color.MAROON]\n    output_grid = input_grid.copy()\n    for index, (row, col) in enumerate(perimeter_cells):\n        output_grid[row, col] = (Color.RED if index == 0 else ordered_colors[index % len(ordered_colors)])\n    return output_grid\n\n\ndef generate_input():\n    radius = random.randint(3,7)\n    size = 2*radius+1\n    grid = np.zeros((size,size), int)\n    center_x = center_y = radius\n    perimeter_cells = []\n    for offset in range(radius): perimeter_cells.append((center_x+radius, center_y-offset))\n    for offset in range(2*radius): perimeter_cells.append((center_x+radius-offset, center_y-radius))\n    for offset in range(2*radius): perimeter_cells.append((center_x-radius, center_y-radius+offset))\n    for offset in range(2*radius): perimeter_cells.append((center_x-radius+offset, center_y+radius))\n    for offset in range(radius): perimeter_cells.append((center_x+radius, center_y+radius-offset))\n    ordered_colors = [Color.RED, Color.ORANGE, Color.YELLOW, Color.GREEN, Color.TEAL, Color.BLUE, Color.MAROON]\n    grid[perimeter_cells[0]] = Color.PINK\n    quarter_len = len(perimeter_cells)//4\n    for index in range(1, quarter_len+1):\n        grid[perimeter_cells[index]] = ordered_colors[(index-1) % len(ordered_colors)]\n    draw_line(grid, center_x, 0, center_x, size-1, color=Color.GREY)\n    draw_line(grid, 0, center_y, size-1, center_y, color=Color.GREY)\n    return grid\n",
